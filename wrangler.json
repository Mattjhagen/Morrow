{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "velourmarket",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist/client"
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
